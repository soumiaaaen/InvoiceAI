{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SmartFactureTrackerDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY"
  },
  
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_AT_LEAST_64_CHARS",
    "Issuer": "SmartFactureTracker",
    "Audience": "SmartFactureTrackerUsers",
    "ExpiryMinutes": 60
  }
}
